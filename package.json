{
  "name": "vfan-tv",
  "version": "0.11.0",
  "private": true,
  "description": "一款免费开源、跨平台的桌面端影视聚合客户端（空壳）。",
  "homepage": "https://github.com/vfanlee/vfan-tv#readme",
  "bugs": {
    "url": "https://github.com/vfanlee/vfan-tv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vfanlee/vfan-tv.git"
  },
  "license": "GPL-3.0",
  "author": "VfanLee",
  "main": ".vite/build/main.js",
  "scripts": {
    "build": "pnpm run package",
    "build:dir": "pnpm run package",
    "build:mac": "pnpm run make:mac",
    "build:mac:arm64": "pnpm run make:mac:arm64",
    "build:mac:x64": "pnpm run make:mac:x64",
    "build:win": "pnpm run make:win:x64",
    "build:win:arm64": "pnpm run make:win:arm64",
    "build:win:x64": "pnpm run make:win:x64",
    "db:generate": "drizzle-kit generate",
    "dev": "electron-forge start",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "make:mac": "pnpm run make:mac:arm64 && pnpm run make:mac:x64",
    "make:mac:arm64": "cross-env VFTV_TARGET_ARCH=arm64 electron-forge make --platform=darwin --arch=arm64",
    "make:mac:x64": "cross-env VFTV_TARGET_ARCH=x64 electron-forge make --platform=darwin --arch=x64",
    "make:win": "pnpm run make:win:x64 && pnpm run make:win:arm64",
    "make:win:arm64": "cross-env VFTV_TARGET_ARCH=arm64 electron-forge make --platform=win32 --arch=arm64",
    "make:win:x64": "cross-env VFTV_TARGET_ARCH=x64 electron-forge make --platform=win32 --arch=x64",
    "package": "pnpm run typecheck && electron-forge package",
    "prepare": "husky",
    "publish:mac:arm64": "cross-env VFTV_TARGET_ARCH=arm64 electron-forge publish --platform=darwin --arch=arm64",
    "publish:mac:x64": "cross-env VFTV_TARGET_ARCH=x64 electron-forge publish --platform=darwin --arch=x64",
    "publish:win:arm64": "cross-env VFTV_TARGET_ARCH=arm64 electron-forge publish --platform=win32 --arch=arm64",
    "publish:win:x64": "cross-env VFTV_TARGET_ARCH=x64 electron-forge publish --platform=win32 --arch=x64",
    "rebuild:native": "electron-rebuild --force --only better-sqlite3",
    "release": "electron-forge publish",
    "start": "electron-forge start",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,css,md,html}": "prettier --write"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@xmldom/xmldom": "^0.8.13",
    "better-sqlite3": "^12.10.0",
    "bs58": "^6.0.0",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "6.3.9",
    "es-toolkit": "^1.50.0",
    "file-type": "^22.0.1",
    "iptv-playlist-parser": "^0.15.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/publisher-github": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/fuses": "1.8.0",
    "@electron/rebuild": "4.2.0",
    "@felixrieseberg/electron-forge-maker-nsis": "7.2.0",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-virtual": "3.14.9",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "artplayer": "5.4.0",
    "artplayer-plugin-ambilight": "1.1.0",
    "artplayer-plugin-audio-track": "1.1.0",
    "artplayer-plugin-hls-control": "1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "43.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "hls.js": "^1.6.16",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "lucide-react": "^1.18.0",
    "mpegts.js": "^1.8.0",
    "postcss": "8.5.25",
    "prettier": "^3.7.4",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-icons": "^5.6.0",
    "react-router": "^7.17.0",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "5.4.21",
    "zustand": "^5.0.14"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.11 <25",
    "pnpm": "11.20.0"
  }
}

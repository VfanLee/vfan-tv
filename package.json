{
  "name": "vfan-tv",
  "version": "0.12.0",
  "private": true,
  "description": "一款免费开源、跨平台的桌面端影视聚合客户端（空壳）。",
  "homepage": "https://github.com/vfanlee/vfan-tv#readme",
  "bugs": {
    "url": "https://github.com/vfanlee/vfan-tv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vfanlee/vfan-tv.git"
  },
  "license": "GPL-3.0",
  "author": "VfanLee",
  "type": "module",
  "scripts": {
    "build": "tauri build",
    "build:app": "tauri build --no-bundle",
    "build:mac:arm64": "tauri build --target aarch64-apple-darwin --bundles dmg",
    "build:mac:x64": "tauri build --target x86_64-apple-darwin --bundles dmg",
    "build:web": "vite build --config config/vite.tauri.config.ts",
    "build:win:arm64": "tauri build --target aarch64-pc-windows-msvc --bundles nsis",
    "build:win:x64": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "check": "pnpm run check:versions && pnpm run typecheck && pnpm run lint && pnpm run check:rust",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:versions": "node config/check-versions.ts",
    "dev": "tauri dev",
    "dev:web": "vite --config config/vite.tauri.config.ts",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint": "eslint --cache .",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "prepare": "husky",
    "test": "pnpm run test:rust && pnpm run test:frontend",
    "test:frontend": "node --experimental-vm-modules --test config/*.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,css,md,html}": "prettier --write"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "5.2.10",
    "@tanstack/react-virtual": "3.14.9",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-log": "2.9.1",
    "@tauri-apps/plugin-opener": "^2",
    "artplayer": "5.4.0",
    "artplayer-plugin-ambilight": "1.1.0",
    "artplayer-plugin-audio-track": "1.1.0",
    "artplayer-plugin-hls-control": "1.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.21",
    "es-toolkit": "1.50.0",
    "hls.js": "1.6.16",
    "lucide-react": "1.23.0",
    "mpegts.js": "1.8.0",
    "radix-ui": "1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "5.7.0",
    "react-router": "7.18.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "postcss": "8.5.25",
    "prettier": "3.9.4",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-tailwindcss": "0.8.0",
    "shadcn": "4.13.0",
    "tailwindcss": "4.3.2",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "^8.0.16"
  },
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24.14 <25",
    "pnpm": "11.26.0"
  }
}

{
  "extends": [
    "@electron-toolkit/tsconfig/tsconfig.node.json",
  ],
  "include": [
    "config/**/*.ts",
    "forge.config.ts",
    "drizzle.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["node", "@electron-forge/plugin-vite/forge-vite-env"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  }
}
